# Dockerfile.wasix
# Assuming binary is already built at wasix_eth/target/wasm32-wasmer-wasi/release/wasix_eth.wasi.wasm
FROM debian:bookworm-slim

WORKDIR /app

# Install Wasmer
RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*
RUN curl https://get.wasmer.io -sSfL | sh -s "v7.4.2"
ENV PATH="/root/.wasmer/bin:${PATH}"

# Copy the pre-built .wasm file
COPY target/wasm32-wasmer-wasi/release/wasix_eth.wasi.wasm /app/wasix_eth.wasm

# Set the entrypoint to run with Wasmer
ENTRYPOINT ["wasmer", "run", "/app/wasix_eth.wasm", "--enable-async-threads", "--net", "--"]
