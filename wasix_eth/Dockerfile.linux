# Dockerfile.linux
# Assuming binary is already built at wasix_eth/target/x86_64-unknown-linux-gnu/release/wasix_eth
FROM debian:bookworm-slim

WORKDIR /app

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    libssl3 \
    ca-certificates \
    prometheus-node-exporter \
    && rm -rf /var/lib/apt/lists/*

# Copy the pre-built binary
COPY target/x86_64-unknown-linux-gnu/release/wasix_eth /app/wasix_eth

# Set the entrypoint
ENTRYPOINT ["/app/wasix_eth"]
