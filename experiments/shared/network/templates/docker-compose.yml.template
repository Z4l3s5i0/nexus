networks:
  blockchain-net:
    driver: bridge

services:
  # Metrics Server
  metrics-server:
    image: ${METRICS_IMAGE:-wasix-eth-metrics:latest}
    stop_signal: SIGINT
    stop_grace_period: 2m
    # Fallback to build if image not found or requested
    ${METRICS_BUILD_SECTION:-# No build section}
    ports:
      - "${METRICS_SERVER_BIND:-0.0.0.0}:9100:9100"
    environment:
      METRICS_INGEST_TOKEN: ${METRICS_INGEST_TOKEN:-}
      EXPERIMENT_RUN_ID: ${EXPERIMENT_RUN_ID:-}
    volumes:
      - ./data_v2/metrics-server:/app/data
    networks:
      - blockchain-net
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:9100/health"]
      interval: 10s
      timeout: 5s
      retries: 5

  # Prometheus
  prometheus:
    image: prom/prometheus:v2.53.1
    volumes:
      - ./startup_v2/prometheus.yml:/etc/prometheus/prometheus.yml
      - ./startup_v2/node-exporter-targets.json:/etc/prometheus/node-exporter-targets.json:ro
      - ./startup_v2/execution-node-targets.json:/etc/prometheus/execution-node-targets.json:ro
      - prometheus-data:/prometheus
    command:
      - '--config.file=/etc/prometheus/prometheus.yml'
      - '--storage.tsdb.path=/prometheus'
      - '--web.console.libraries=/usr/share/prometheus/console_libraries'
      - '--web.console.templates=/usr/share/prometheus/consoles'
    ports:
      - "9091:9090"
    networks:
      - blockchain-net

  # Grafana
  grafana:
    image: grafana/grafana:11.1.0
    volumes:
      - grafana-data:/var/lib/grafana
      - ./startup_v2/grafana/provisioning:/etc/grafana/provisioning
      - ./startup_v2/grafana/dashboards:/var/lib/grafana/dashboards
    environment:
      - GF_SECURITY_ADMIN_PASSWORD=admin
      - GF_USERS_ALLOW_SIGN_UP=false
    ports:
      - "3000:3000"
    networks:
      - blockchain-net
    depends_on:
      - prometheus

  # Node Exporter
  node-exporter:
    image: prom/node-exporter:v1.8.1
    volumes:
      - /proc:/host/proc:ro
      - /sys:/host/sys:ro
      - /:/rootfs:ro
    command:
      - '--path.procfs=/host/proc'
      - '--path.sysfs=/host/sys'
      - --collector.filesystem.ignored-mount-points
      - "^/(sys|proc|dev|host|etc)($$|/)"
    ports:
      - "9101:9100"
    networks:
      - blockchain-net

  # Per-container resource metrics for all execution nodes
  cadvisor:
    image: gcr.io/cadvisor/cadvisor:v0.61.0
    privileged: true
    command:
      - --docker_only=true
      - --store_container_labels=false
      - --whitelisted_container_labels=experiment_node_index,experiment_client,experiment_runtime_variant,experiment_node_service
      - --housekeeping_interval=5s
    volumes:
      - /:/rootfs:ro
      - /var/run:/var/run:ro
      - /sys:/sys:ro
      - /sys/fs/cgroup:/sys/fs/cgroup:ro
      - /var/lib/docker/:/var/lib/docker:ro
      - /dev/disk/:/dev/disk:ro
    networks:
      - blockchain-net

# Individual node services will be appended here by the generator script
